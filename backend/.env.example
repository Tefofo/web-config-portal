# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/configuration_portal?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# Generate strong random secrets in real environments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# --- CORS ---
# Comma-separated list of allowed browser origins (portal + public site renderer).
FRONTEND_URL="http://localhost:4200,http://localhost:4300"

# --- Seed (development only) ---
SEED_DEMO_PASSWORD="Password123!"
